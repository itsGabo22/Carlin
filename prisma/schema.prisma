generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────

enum Role {
  CLIENTE
  MAYORISTA
  DISTRIBUIDOR
  ADMIN
}

enum DiscountScope {
  GLOBAL
  CATEGORY
  PRODUCT
}

enum DiscountAudience {
  ALL
  WHOLESALE
  DISTRIBUTOR
}

enum HeroSlideType {
  IMAGE
  VIDEO
}

enum PriceLevel {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

// ── Models ─────────────────────────────────────────────

model SiteConfig {
  id                   String   @id @default("singleton")
  wholesaleMinOrder    Decimal  @db.Decimal(10, 2)
  distributorMinOrder  Decimal  @db.Decimal(10, 2)
  inactivityDays       Int      @default(30)
  /// Descuento de bienvenida: se aplica automáticamente (sin cupón) en el
  /// PRIMER pedido de un mayorista aprobado. Ver `getWelcomeDiscount()`.
  welcomeDiscountActive     Boolean @default(false)
  welcomeDiscountPercentage Decimal @default(0) @db.Decimal(5, 2)
  /// Textos e imagen del panel de bienvenida, editables desde /admin.
  /// Si están vacíos, el panel usa su copy por defecto. `welcomeTitle` admite
  /// el token {nombre}. Si hay `welcomeImageUrl`, la imagen sustituye a la
  /// cabecera degradada y NO se le superpone texto (ver WelcomePanel).
  welcomeTitle              String?
  welcomeMessage            String?
  welcomeImageUrl           String?
  announcementText     String?
  announcementActive   Boolean  @default(false)
  heroUseVideo         Boolean  @default(false)
  catalogMaquillajeUrl String?
  catalogCapilarUrl    String?
  updatedAt            DateTime @updatedAt
}

model HeroSlide {
  id             String        @id @default(cuid())
  type           HeroSlideType @default(IMAGE)
  desktopUrl     String        
  mobileUrl      String?       
  title          String?       
  subtitle       String?       
  ctaText        String?       
  ctaHref        String?       
  order          Int           @default(0)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
}

/// Categorías y subcategorías viven en el MISMO modelo, en árbol vía `parentId`.
/// Una "subcategoría" es simplemente una Category con parentId != null.
/// No existe un modelo Subcategory aparte a propósito: duplicaría esta jerarquía
/// (hoy 4 raíz + 36 hijas en producción) y rompería las rutas
/// /catalogo/[categoria]/[subcategoria], el CRUD admin, la home y el sitemap.
model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  /// Imagen del círculo de subcategoría / mosaico de categoría en la home.
  imageUrl    String?
  parentId    String?
  groupByBrand Boolean @default(false)
  /// Oculta la categoría del catálogo público sin borrarla ni tocar sus productos.
  active      Boolean    @default(true)
  /// Orden manual dentro de su nivel (menor primero); desempata por `name`.
  order       Int        @default(0)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  discounts   Discount[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId, active, order])
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  logoUrl     String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]
}

model Product {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String?
  retailPrice      Decimal           @db.Decimal(10, 2)
  wholesalePrice   Decimal           @db.Decimal(10, 2)
  distributorPrice Decimal           @db.Decimal(10, 2)
  comparePrice     Decimal?          @db.Decimal(10, 2)
  sku              String?           @unique
  stock            Int               @default(0)
  unit             String?      
  tones            String[]     
  imageUrls        String[]
  featured         Boolean           @default(false)
  active           Boolean           @default(true)
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?            @relation(fields: [brandId], references: [id])
  tags             ProductTag[]
  discounts        Discount[]
  discountProducts DiscountProduct[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName  String
  colorHex   String?
  imageUrl   String
  stock      Int         @default(0)
  active     Boolean     @default(true)
  order      Int         @default(0)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([productId, active, order])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Discount {
  id         String            @id @default(cuid())
  code       String?           @unique
  couponCode String?           @unique
  label      String
  percentage Decimal           @db.Decimal(5, 2)
  scope      DiscountScope
  audience   DiscountAudience  @default(ALL)
  productId  String?
  product    Product?          @relation(fields: [productId], references: [id])
  categoryId String?
  category   Category?         @relation(fields: [categoryId], references: [id])
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  products   DiscountProduct[]
}

model DiscountProduct {
  discountId String
  productId  String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
}


model WholesaleUser {
  id             String    @id @default(cuid())
  authId         String    @unique
  email          String    @unique
  name           String?
  role           Role      @default(MAYORISTA)
  businessName   String?
  taxId          String?
  phone          String?
  city           String?
  approved       Boolean   @default(false)
  /// Momento en que el admin aprobó la cuenta. Sirve de fecha base para
  /// `isWholesaleActive()` mientras el mayorista aún no ha hecho su primer
  /// pedido: sin esto, una cuenta recién aprobada caía a precio RETAIL.
  approvedAt     DateTime?
  lastOrderAt    DateTime?
  /// Se sella al crear el pedido que consume el descuento de bienvenida.
  welcomeDiscountUsedAt DateTime?
  /// Se sella cuando el usuario cierra el panel de bienvenida (se muestra 1 vez).
  welcomeSeenAt  DateTime?
  orders         Order[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Order {
  id              String         @id @default(cuid())
  wholesaleUserId String?
  wholesaleUser   WholesaleUser? @relation(fields: [wholesaleUserId], references: [id])
  guestEmail      String?
  customerName    String?
  customerPhone   String?
  priceLevel      PriceLevel     @default(RETAIL)
  total           Decimal        @db.Decimal(10, 2)
  /// Snapshot del descuento de bienvenida aplicado a ESTE pedido (si aplicó).
  welcomeDiscountPct    Decimal? @db.Decimal(5, 2)
  welcomeDiscountAmount Decimal? @db.Decimal(10, 2)
  status          String         @default("PENDING")
  items           OrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  name          String
  priceSnapshot Decimal         @db.Decimal(10, 2)
  quantity      Int
  imageUrl      String?
}

model PromoPopup {
  id        String   @id @default("singleton")
  active    Boolean  @default(false)
  imageUrl  String?
  title     String?
  subtitle  String?
  ctaText   String?  @default("Ver oferta")
  ctaHref   String?
  showOnce  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model ImageBandeja {
  id        String   @id @default(cuid())
  url       String
  filename  String
  assigned  Boolean  @default(false)
  productId String?
  createdAt DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  email     String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Franja "Síguenos en Instagram" de la home.
/// A propósito NO se conecta con la API de Instagram: eso exige revisión de app
/// de Meta y refrescar tokens, demasiado frágil para una sección decorativa.
/// Se administra como el resto del contenido: imagen subida + enlace al post.
model InstagramPost {
  id        String   @id @default(cuid())
  imageUrl  String
  linkUrl   String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model MarqueeMessage {
  id        String   @id @default(cuid())
  message   String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
